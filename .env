# ============================================================
# FebBox HLS Pool — environment variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- Database (REQUIRED) -------------------------------------
# MariaDB / MySQL connection string.
# Your VPS example (password contains "@" — a literal "@" is fine,
# the parser splits at the last one; URL-encoding as %40 is cleaner):
DATABASE_URL=mysql://root:Mariadb24%40@vvdg0b6qpjl63373qo3vpk8h:3306/febusage?ssl=true&sslaccept=accept_invalid_certs

# Create the tables first: import schema.sql via phpMyAdmin
# (select the `febusage` database → SQL tab → paste file → Go).

# --- Proxy (optional, recommended) ----------------------------
# Webshare rotating proxy used for FebBox requests.
DEFAULT_PROXY_URL=http://dkmxrsew-rotate:hd1zl1cegrxs@p.webshare.io:80
DEFAULT_PROXY_ENABLED=true

# --- Usage guard ----------------------------------------------
# Park an account at limit_reached once its estimated usage passes this.
USAGE_LIMIT_GB=100
# Auto-add estimated file size to usage after every successful fetch.
AUTO_USAGE=true

# --- Optional first-run seed -----------------------------------
# One full cookie string; loaded on first start only when the pool is empty.
# FEBBOX_SEED_COOKIE=ci=...; PHPSESSID=...; ui=...

# --- Dashboard password (recommended on a public VPS) -----------
# If set, the UI asks for it once and sends it as x-app-password.
APP_PASSWORD=Feb1234

# --- Server -----------------------------------------------------
PORT=3000
